# Copy this file to .env and fill in real values. .env should NOT be committed to git.

# --- Postgres (app warehouse) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retailpulse
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=retailpulse

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=retailpulse

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO (S3-compatible data lake) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=retailpulse
MINIO_SECRET_KEY=retailpulse123
MINIO_BUCKET=retailpulse-lake

# --- GenAI layer ---
# Option A: local Ollama (no key needed, just run `ollama serve` on your machine)
OLLAMA_URL=http://localhost:11434

# Option B: free-tier hosted API (pick one, get a free key from their site)
# GROQ_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here

# --- Airflow ---
AIRFLOW_UID=50000
